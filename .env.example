AIAND_API_KEY=sk-your-api-key
AIAND_MODEL=deepseek-ai/deepseek-v4-flash
AIAND_VISION_MODEL=deepseek-ai/deepseek-v4.1-flash
# Independent checker from a different model family (optional; this is the default)
AIAND_CHECK_MODEL=qwen/qwen3.8-27b
# Cultural background notes: one writer and reviewers from other families (optional; these are the defaults)
AIAND_CULTURE_MODEL=deepseek-ai/deepseek-v4-pro
AIAND_REVIEW_MODELS=zai-org/glm-5.3,qwen/qwen3.8-27b
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j
# Optional local SAM3 segmentation (npm run up starts the sidecar when both are set; see README)
# SAM3_PYTHON=/Users/you/models/sam3/.venv/bin/python
# SAM3_MODEL_DIR=/Users/you/models/sam3/facebook-sam3
# Set only if you run scripts/sam3_server.py yourself instead of through npm run up
# SAM3_URL=http://127.0.0.1:8010
