AIAND_API_KEY=sk-your-api-key
AIAND_MODEL=deepseek-ai/deepseek-v4-flash
AIAND_VISION_MODEL=deepseek-ai/deepseek-v4.1-flash
# Independent checker from a different model family (optional; this is the default)
AIAND_CHECK_MODEL=qwen/qwen3.8-27b
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j
